{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BioML-Insight paper inventory",
  "description": "One record per candidate publication. Records are added only from search-tool output; bibliographic fields are never typed from memory. Status: schema PROPOSED in P001, pending approval with the search strategy.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["paper_id", "title", "year", "source_db", "query_id", "retrieved_on", "verification_status", "screening_status"],
    "additionalProperties": false,
    "properties": {
      "paper_id": {"type": "string", "pattern": "^P[0-9]{4}$", "description": "Internal ID, e.g. P0001"},
      "title": {"type": "string"},
      "authors": {"type": "string", "description": "As returned by the source, semicolon-separated"},
      "year": {"type": "integer"},
      "venue": {"type": "string"},
      "doi": {"type": ["string", "null"]},
      "pmid": {"type": ["string", "null"]},
      "arxiv_id": {"type": ["string", "null"]},
      "url": {"type": ["string", "null"]},
      "source_db": {"type": "string", "enum": ["pubmed", "consensus", "arxiv", "web", "manual"]},
      "query_id": {"type": "string", "description": "ID of the search query in search_strategy.md that found it"},
      "retrieved_on": {"type": "string", "format": "date"},
      "verification_status": {"type": "string", "enum": ["verified", "partially_verified", "unverified", "failed"], "description": "verified = title, authors, year and an identifier confirmed by a second lookup"},
      "verification_note": {"type": "string"},
      "screening_status": {"type": "string", "enum": ["not_screened", "included", "excluded_title_abstract", "excluded_full_text"]},
      "exclusion_reason": {"type": ["string", "null"]},
      "disorder": {"type": ["string", "null"]},
      "biomarker_type": {"type": ["string", "null"]},
      "dataset": {"type": ["string", "null"]},
      "sample_size": {"type": ["integer", "null"]},
      "models": {"type": ["string", "null"]},
      "explainability": {"type": ["string", "null"]},
      "calibration_or_uncertainty": {"type": ["string", "null"]},
      "validation_design": {"type": ["string", "null"]},
      "reported_metrics": {"type": ["string", "null"], "description": "Copied verbatim from the paper with location, never paraphrased into new numbers"},
      "limitations_noted": {"type": ["string", "null"]},
      "notes": {"type": ["string", "null"]}
    }
  }
}
