{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication record (deduplicated)",
  "description": "LIT-002. One record per publication after deduplication. Bibliographic fields come from the highest-priority source record (field_provenance says which); disagreeing values are listed in metadata_conflicts, never silently overwritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "source_databases",
    "source_urls",
    "primary_source_record_id",
    "field_provenance",
    "search_provenance",
    "duplicate_status",
    "n_source_records",
    "possible_duplicates",
    "metadata_conflicts",
    "verification_status",
    "verification_note",
    "full_text_availability",
    "screening_decision",
    "screening_stage",
    "exclusion_reason",
    "retracted",
    "title",
    "authors",
    "year",
    "journal",
    "doi",
    "pmid",
    "pmcid",
    "arxiv_id",
    "source_url",
    "abstract",
    "publication_types",
    "language"
  ],
  "properties": {
    "paper_id": {
      "type": "string",
      "pattern": "^P\\d{4,}$",
      "description": "Internal ID, stable across rebuilds via records/paper_id_registry.csv"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "fore_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "initials": {
            "type": [
              "string",
              "null"
            ]
          },
          "collective_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2100
    },
    "journal": {
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^10\\.\\d{4,9}/\\S+$",
      "description": "lower-case, no resolver prefix"
    },
    "pmid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9]\\d{0,9}$"
    },
    "pmcid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PMC\\d+$"
    },
    "arxiv_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "without version suffix"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "abstract": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_types": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_databases": {
      "type": "array",
      "items": {
        "enum": [
          "pubmed",
          "europepmc",
          "crossref",
          "arxiv",
          "semantic_scholar",
          "consensus",
          "publisher_site",
          "repository",
          "google_scholar",
          "citation_chasing",
          "web",
          "manual"
        ]
      },
      "minItems": 1
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_source_record_id": {
      "type": "string"
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "search_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "query_string",
          "source",
          "search_timestamp",
          "rank",
          "source_record_id"
        ],
        "properties": {
          "query_id": {
            "type": "string"
          },
          "query_string": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "enum": [
              "pubmed",
              "europepmc",
              "crossref",
              "arxiv",
              "semantic_scholar",
              "consensus",
              "publisher_site",
              "repository",
              "google_scholar",
              "citation_chasing",
              "web",
              "manual"
            ]
          },
          "search_timestamp": {
            "type": "string"
          },
          "rank": {
            "type": "integer"
          },
          "source_record_id": {
            "type": "string"
          }
        }
      }
    },
    "duplicate_status": {
      "enum": [
        "unique",
        "merged_duplicates",
        "possible_duplicate_review"
      ]
    },
    "n_source_records": {
      "type": "integer",
      "minimum": 1
    },
    "possible_duplicates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "values"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "minItems": 2
          }
        }
      }
    },
    "verification_status": {
      "enum": [
        "verified",
        "partially_verified",
        "unverified",
        "needs_review",
        "failed"
      ]
    },
    "verification_note": {
      "type": "string"
    },
    "full_text_availability": {
      "enum": [
        "not_checked",
        "pmc_record",
        "pmc_full_text_retrieved",
        "arxiv_preprint",
        "publisher_open_access",
        "researcher_pdf",
        "abstract_only",
        "unavailable"
      ]
    },
    "screening_decision": {
      "enum": [
        "not_screened",
        "include",
        "exclude",
        "uncertain",
        "abstract_only"
      ]
    },
    "screening_stage": {
      "enum": [
        null,
        "title_abstract",
        "full_text"
      ]
    },
    "exclusion_reason": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^E(1[0-2]|[1-9])$"
    },
    "rq5_components": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "D-035 (Q-041; APPROVED - CONDITIONAL, inactive for screening): RQ5 component statuses by evidence stage. preliminary = latest title/abstract row (triage only, never counted toward D-031/D-034); confirmed = latest full-text row (not for abstract_only decisions), with earlier full-text rows kept as history. null = no component recorded. classification is recorded in dim_classification (D-036, Q-039)",
      "properties": {
        "preliminary": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "statuses": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feature_selection": {"enum": ["yes", "no", "unclear", null]},
                "classification": {"enum": ["yes", "no", "unclear", null]},
                "explainability": {"enum": ["yes", "no", "unclear", null]},
                "calibration": {"enum": ["yes", "no", "unclear", null]},
                "uncertainty": {"enum": ["yes", "no", "unclear", null]}
              }
            },
            "screener": {"type": "string"},
            "date": {"type": "string"}
          }
        },
        "confirmed": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "statuses": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feature_selection": {"enum": ["yes", "no", "unclear", null]},
                "classification": {"enum": ["yes", "no", "unclear", null]},
                "explainability": {"enum": ["yes", "no", "unclear", null]},
                "calibration": {"enum": ["yes", "no", "unclear", null]},
                "uncertainty": {"enum": ["yes", "no", "unclear", null]}
              }
            },
            "screener": {"type": "string"},
            "date": {"type": "string"},
            "researcher_verified": {"type": "boolean"},
            "changed_by_verification": {"type": "boolean"},
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "screener": {"type": "string"},
                  "date": {"type": "string"},
                  "decision": {"type": "string"},
                  "statuses": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feature_selection": {"enum": ["yes", "no", "unclear", null]},
                "classification": {"enum": ["yes", "no", "unclear", null]},
                "explainability": {"enum": ["yes", "no", "unclear", null]},
                "calibration": {"enum": ["yes", "no", "unclear", null]},
                "uncertainty": {"enum": ["yes", "no", "unclear", null]}
              }
            }
                }
              }
            }
          }
        },
        "confirmation_note": {"type": ["string", "null"]}
      }
    },
    "rq5_coverage_group": {
      "enum": ["qualified", "near_rq5", "below_threshold", null],
      "description": "D-034 coverage group, derived by the build (D-036) from rq5_components.confirmed.statuses only: qualified = >= 4 yes, near_rq5 = exactly 3, below_threshold = 0-2; unclear never counts as yes. null = no confirmed full-text assessment (not assessed). A coverage descriptor, not a quality judgment; never assigned by a screener. Inactive for screening (D-031 to D-036 conditions)"
    },
    "rq5_coverage_provisional": {
      "type": ["boolean", "null"],
      "description": "D-034, D-037-A1: true only when resolving the confirmed unclear statuses to yes or no (all other statuses held fixed) could change rq5_coverage_group; false when every resolution gives the same group (so qualified is never provisional). The unclear statuses themselves stay in rq5_components. null when rq5_coverage_group is null"
    },
    "retracted": {
      "type": "boolean"
    },
    "publication_type": {
      "type": "string",
      "enum": ["retraction_notice", "expression_of_concern", "erratum_or_correction", "study_protocol", "dataset", "preprint", "review", "guideline_or_consensus", "editorial_comment_letter", "conference_paper", "journal_article", "unknown", "other"],
      "description": "D-028 2a-2c: derived by the build from publication_types (and source database arXiv) only, first match wins; never hand-edited. Written by every build from T1-A on; absent from records built earlier, so not listed in required until the T2 rebuild"
    },
    "screening_details": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "LIT-004-WORKFLOW-FIXES: the latest screening row for this paper (from screening/decisions.csv), null if not screened",
      "properties": {
        "screener": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "justification": {
          "type": [
            "string",
            "null"
          ]
        },
        "rq_tags": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_flags": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "biomarker_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "D-058"
        },
        "dim_explainability": {
          "type": [
            "string",
            "null"
          ]
        },
        "dim_uncertainty": {
          "type": [
            "string",
            "null"
          ]
        },
        "dim_calibration": {
          "type": [
            "string",
            "null"
          ]
        },
        "dim_feature_selection": {
          "type": [
            "string",
            "null"
          ]
        },
        "dim_classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "dim_independent_validation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Retired screening column (replaced by validation_design, D-029/D-060); no longer written. Removed from this schema at T2"
        },
        "validation_design": {
          "type": [
            "string",
            "null"
          ],
          "description": "Screening descriptor (D-060 (1)); shown in the inventory as screening_validation_design"
        },
        "criteria_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "needs_human": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
