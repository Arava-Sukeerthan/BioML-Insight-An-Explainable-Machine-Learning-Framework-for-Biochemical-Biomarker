+    def test_q098_rule(self):
+        D = lambda *p: {"date-parts": [list(p)]}
+        self.assertEqual(pr.CROSSREF_YEAR_FIELDS, ("published-print", "published-online"))
+        self.assertEqual(pr.crossref_year({"published-print": D(2021, 1), "published-online": D(2020, 12),
+                                           "issued": D(2020, 12)}), 2021)          # online-first: print wins
+        self.assertEqual(pr.crossref_year({"published-online": D(2022, 3), "issued": D(2022, 3)}), 2022)
+        self.assertIsNone(pr.crossref_year({"issued": D(2019)}))                   # issued is never used
+        for empty in ({"date-parts": [[]]}, {"date-parts": [[None]]}):                # fail-closed at intake
+            with self.assertRaises(ValueError):
+                pr.crossref_year({"published-print": empty, "published-online": D(2020)})
+
